# ---- build output ---------------------------------------------------------
/target
/engine/build/
**/*.rs.bk

# Cargo.lock IS committed: this workspace ships a binary (crates/shell), so the
# lock is what makes a build reproducible. Only pure libraries omit it.

# ---- compiler / linker artifacts ------------------------------------------
# Everything under _qa/fixtures is SOURCE; these are what building it leaves
# behind (fixtures/corpus/compile_all.bat, fixtures/selfdll/*.sh).
*.exe
*.dll
*.obj
*.pdb
*.exp
*.lib
*.ilk
*.log
*.dat

# ---- generated QA output --------------------------------------------------
# Everything the QA loop produces now lands under _qa/out (pairs/, decomp/,
# verify/, work/, reports). One targeted rule replaces the old blanket `/_qa/`
# ignore, which also hid the harness, gate scripts and fixtures — they had to be
# force-added on every commit, which is how generated dumps got committed by
# accident in the first place.
/_qa/out/

# ---- app runtime state ----------------------------------------------------
.disasmstudio/
/_demo/

# ---- reserved Windows device-name junk (git cannot index these) -----------
NUL
**/NUL
CON
AUX
PRN
